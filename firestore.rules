rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validText(t, max) { return t is string && t.size() > 0 && t.size() <= max; }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['displayName','updatedAt','avatar']) && validText(request.resource.data.displayName,35);
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','updatedAt','avatar']) && (!('displayName' in request.resource.data) || validText(request.resource.data.displayName,35));
      allow delete: if signedIn() && request.auth.uid == uid;
      match /blocked/{blockedUid} {
        allow read, create, delete: if signedIn() && request.auth.uid == uid && blockedUid != uid;
        allow update: if false;
      }
    }
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['name','type','ownerUid','ownerName','createdAt','status']) && request.resource.data.ownerUid == request.auth.uid && validText(request.resource.data.name,55) && validText(request.resource.data.ownerName,35) && request.resource.data.type in ['audio','video'] && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'open'
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'closed')
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stageGuests'])
           && request.resource.data.stageGuests is map
           && request.resource.data.stageGuests.size() <= (resource.data.type == 'audio' ? 7 : 1)
           && !request.resource.data.stageGuests.keys().hasAny([request.auth.uid]))
        );
      allow delete: if false;
      match /stageRequests/{uid} {
        function room() { return get(/databases/$(database)/documents/rooms/$(roomId)).data; }
        allow get: if signedIn() && (request.auth.uid == uid || room().ownerUid == request.auth.uid);
        allow list: if signedIn() && room().ownerUid == request.auth.uid;
        allow create: if signedIn() && request.auth.uid == uid && room().ownerUid != uid && room().status == 'open'
          && request.resource.data.keys().hasOnly(['name','createdAt'])
          && validText(request.resource.data.name,35) && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (request.auth.uid == uid || room().ownerUid == request.auth.uid);
        allow update: if false;
      }
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)) && get(/databases/$(database)/documents/rooms/$(roomId)).data.status == 'open' && request.resource.data.keys().hasOnly(['text','userUid','userName','createdAt']) && request.resource.data.userUid == request.auth.uid && validText(request.resource.data.userName,35) && validText(request.resource.data.text,500) && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.userUid == request.auth.uid || get(/databases/$(database)/documents/rooms/$(roomId)).data.ownerUid == request.auth.uid);
      }
    }
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['roomId','reportedUid','messageId','reporterUid','reason','createdAt','status']) && request.resource.data.reporterUid == request.auth.uid && validText(request.resource.data.roomId,128) && validText(request.resource.data.reason,200) && request.resource.data.status == 'new' && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
