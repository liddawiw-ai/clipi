{
  "name": "clipi",
  "version": "1.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "expo install --check",
    "test:release": "node scripts/check-release.cjs",
    "test:syntax": "node scripts/check-syntax.cjs",
    "test:ci": "npm run test:syntax && npm run test:release && npm run test:wallet",
    "test:wallet": "node --test tests/wallet-safety.test.cjs tests/cash-payout.test.cjs",
    "test:firestore": "node --test tests/firestore.rules.test.cjs",
    "test:firestore:emulator": "npx --yes firebase-tools@14.2.1 emulators:exec --project demo-clipi-rules --only firestore \"npm run test:firestore\""
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "12.0.0",
    "@livekit/react-native": "2.9.5",
    "@livekit/react-native-expo-plugin": "1.0.1",
    "@livekit/react-native-webrtc": "137.0.2",
    "@react-native-firebase/app": "^22.1.0",
    "@react-native-firebase/app-check": "^22.4.0",
    "@react-native-firebase/auth": "^22.1.0",
    "@react-native-firebase/firestore": "^22.1.0",
    "@react-native-firebase/functions": "^22.1.0",
    "@react-native-google-signin/google-signin": "^14.0.2",
    "expo": "~53.0.0",
    "expo-asset": "11.1.7",
    "expo-audio": "0.4.9",
    "expo-build-properties": "~0.14.8",
    "expo-camera": "~16.1.5",
    "expo-constants": "17.1.8",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.0",
    "expo-file-system": "~18.1.11",
    "expo-image-manipulator": "~13.1.7",
    "expo-image-picker": "^16.1.4",
    "expo-local-authentication": "~16.0.5",
    "expo-status-bar": "~2.2.3",
    "expo-video": "~2.2.2",
    "livekit-client": "~2.15.4",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "react-native-fbsdk-next": "^13.4.1",
    "react-native-purchases": "9.6.2"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.10",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.6.0"
  }
}
