{
  "name": "clipi",
  "version": "1.1.0",
  "private": true,
  "main": "App.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "check": "expo install --check",
    "test:release": "node scripts/check-release.cjs",
    "test:syntax": "node scripts/check-syntax.cjs",
    "test:ci": "npm run test:syntax && npm run test:release",
    "test:firestore": "node --test tests/firestore.rules.test.cjs",
    "test:firestore:emulator": "npx --yes firebase-tools@14.2.1 emulators:exec --project demo-clipi-rules --only firestore \"npm run test:firestore\""
  },
  "dependencies": {
    "expo": "~53.0.0",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.2",
    "expo-camera": "~16.1.5",
    "expo-crypto": "~14.1.5",
    "expo-dev-client": "~5.2.0",
    "expo-build-properties": "~0.14.8",
    "@react-native-firebase/app": "^22.1.0",
    "@react-native-firebase/auth": "^22.1.0",
    "@react-native-firebase/firestore": "^22.1.0",
    "@react-native-google-signin/google-signin": "^14.0.2",
    "react-native-fbsdk-next": "^13.4.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.10",
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.6.0"
  }
}
